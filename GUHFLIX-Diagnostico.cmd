@echo off
setlocal
set "GUH_DIAG_FOLDER=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $lines=[System.Collections.Generic.List[string]]::new(); function Note([string]$s){Write-Host $s; $script:lines.Add($s)}; $desk=[Environment]::GetFolderPath('Desktop'); $log=Join-Path $desk 'GUHFLIX-diagnostico.txt'; try { Note 'GUHFLIX - diagnostico de abertura'; Note ('Windows: '+[Environment]::OSVersion.VersionString); Note ('Sistema 64 bits: '+[Environment]::Is64BitOperatingSystem); $downloads=Join-Path $env:USERPROFILE 'Downloads'; try {$key=Get-ItemProperty -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders'; $v=$key.'{374DE290-123F-4565-9164-39C4925E467B}'; if($v){$downloads=[Environment]::ExpandEnvironmentVariables($v)}}catch{}; $roots=@($env:GUH_DIAG_FOLDER,$downloads)|Select-Object -Unique; $apps=@(foreach($root in $roots){if(Test-Path -LiteralPath $root){Get-ChildItem -LiteralPath $root -Filter 'GUHFLIX.exe' -File -Recurse -Depth 4 -ErrorAction SilentlyContinue}}); if(!$apps.Count){Note 'Nao encontrei GUHFLIX.exe na pasta Downloads.'; Note 'Envie uma foto mostrando a pasta onde voce extraiu o programa.'}else{$app=$apps|Sort-Object LastWriteTime -Descending|Select-Object -First 1; Note ('Aplicativo: '+$app.FullName); Note ('Tamanho: '+$app.Length+' bytes'); Note ('SHA256: '+(Get-FileHash -LiteralPath $app.FullName -Algorithm SHA256).Hash); foreach($name in @('libmpv-2.dll','vulkan-1.dll')){Note ($name+': '+(Test-Path -LiteralPath (Join-Path $app.DirectoryName $name)))}; $running=@(Get-Process -Name 'GUHFLIX','guhflix-windows' -ErrorAction SilentlyContinue); Note ('Processos GUHFLIX ja abertos: '+$running.Count); Note 'Tentando abrir normalmente, sem administrador...'; $process=Start-Process -FilePath $app.FullName -WorkingDirectory $app.DirectoryName -PassThru -ErrorAction Stop; $handle=$process.Handle; if($process.WaitForExit(12000)){$process.Refresh(); $code=$process.ExitCode; if($null -eq $code){Note 'O Windows nao retornou um codigo de saida.'}else{$hex='{0:X8}' -f [int]$code; Note ('CODIGO DO ERRO: 0x'+$hex+' (decimal '+$code+')'); switch($hex){'C0000135'{Note 'Indicio: uma biblioteca necessaria nao foi encontrada.'};'C0000139'{Note 'Indicio: uma funcao necessaria nao existe em uma biblioteca do Windows.'};'C000007B'{Note 'Indicio: biblioteca invalida ou mistura de 32 e 64 bits.'};'C000001D'{Note 'Indicio: instrucao nao suportada pelo processador.'};'C0000005'{Note 'Indicio: falha de acesso a memoria.'};'00000000'{Note 'O processo terminou sem informar falha. Vamos conferir o restante do registro.'}}}}else{Note ('O processo continua aberto. PID: '+$process.Id); Note ('Titulo da janela: '+$process.MainWindowTitle)}; try{$events=Get-WinEvent -FilterHashtable @{LogName='Application';StartTime=(Get-Date).AddMinutes(-3)} -MaxEvents 30 -ErrorAction SilentlyContinue|Where-Object {$_.Message -like '*GUHFLIX*' -and ($_.Id -eq 1000 -or $_.Id -eq 1001 -or $_.ProviderName -eq 'SideBySide')}|Select-Object -First 2; foreach($event in $events){Note ('Evento Windows '+$event.Id+': '+$event.Message)}}catch{}} }catch{Note ('Falha ao tentar abrir: '+$_.Exception.Message); if($_.Exception.NativeErrorCode){Note ('Erro Windows: '+$_.Exception.NativeErrorCode)}}; try{$lines|Set-Content -LiteralPath $log -Encoding UTF8; Write-Host ''; Write-Host ('Registro salvo: '+$log)}catch{Write-Host 'Nao foi possivel salvar o registro; envie uma foto desta janela.'}; Write-Host ''; Write-Host 'Envie ao chat uma foto do CODIGO DO ERRO ou o arquivo GUHFLIX-diagnostico.txt.';"
echo.
pause
endlocal
